local selectedPlayerName = nil
local specState = false
local specConn = nil
local specTarget = nil
local specTargetCharConn = nil
local origCamType, origCamCFrame

local function stopSpec()
    if specConn then specConn:Disconnect() specConn = nil end
    if specTargetCharConn then specTargetCharConn:Disconnect() specTargetCharConn = nil end
    if specState then
        specState = false
        Camera.CameraType = origCamType or Enum.CameraType.Custom
        if origCamCFrame then Camera.CFrame = origCamCFrame end
        specTarget = nil
        if specToggle then specToggle.set(false) end
    end
end

local function startSpec(target)
    if specState then stopSpec() end
    if not target or target == LocalPlayer then
        notify("Spectate", "Invalid target"); return
    end
    if not getRoot(target) then
        notify("Spectate", "Character not loaded"); return
    end
    origCamType = Camera.CameraType
    origCamCFrame = Camera.CFrame
    Camera.CameraType = Enum.CameraType.Scriptable
    specTarget = target
    specState = true

    specConn = RunService.RenderStepped:Connect(function()
        if not specState or not specTarget then stopSpec() return end
        local root = getRoot(specTarget)
        if not root then return end -- ждём респавна, не крашимся
        local targetCF = root.CFrame + root.CFrame.UpVector * CONFIG.SPEC_OFFSET
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, CONFIG.SPEC_LERP)
    end)

    -- Переподключение при респавне цели
    specTargetCharConn = specTarget.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart", 5)
    end)

    notify("Spectate", "Spectating " .. target.Name)
end

