local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = CONFIG.NOTIFY_DURATION
        })
    end)
    print("[" .. title .. "] " .. text)
end

local function log(msg) print("[NurHub] " .. msg) end

-- Исправлено: ping через Stats (работает везде)
local function getPing()
    local ping = 0
    pcall(function()
        ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
    return ping
end

-- Безопасное копирование
local function copyText(text)
    if setclipboard then
        pcall(setclipboard, text)
        notify("Copied", tostring(text))
        return true
    elseif toclipboard then
        pcall(toclipboard, text)
        notify("Copied", tostring(text))
        return true
    end
    notify("Error", "Clipboard not supported")
    return false
end

-- Безопасное получение Humanoid
local function getHumanoid(plr)
    if not plr or not plr.Character then return nil end
    return plr.Character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(plr)
    if not plr or not plr.Character then return nil end
    return plr.Character:FindFirstChild("HumanoidRootPart")
end

