-- Функция обновления списка игроков
function refreshPlayerListUI()
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local query = searchBox.Text:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if query == "" or plr.Name:lower():find(query, 1, true) then
            local opt = Instance.new("TextButton")
            opt.Size = UDim2.new(1, -6, 0, 34)
            opt.BackgroundColor3 = Color3.fromRGB(42, 50, 62)
            opt.BorderSizePixel = 0
            opt.Text = "  " .. plr.Name
            opt.TextColor3 = Color3.fromRGB(255, 255, 255)
            opt.TextSize = 13
            opt.Font = Enum.Font.Gotham
            opt.TextXAlignment = Enum.TextXAlignment.Left
            opt.AutoButtonColor = false
            opt.Parent = listFrame
            local oc = Instance.new("UICorner"); oc.CornerRadius = UDim.new(0, 6); oc.Parent = opt

            opt.MouseEnter:Connect(function()
                TweenService:Create(opt, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55, 70, 90)}):Play()
            end)
            opt.MouseLeave:Connect(function()
                if selectedPlayerName ~= plr.Name then
                    TweenService:Create(opt, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(42, 50, 62)}):Play()
                end
            end)
            opt.MouseButton1Click:Connect(function()
                selectedPlayerName = plr.Name
                for _, c in ipairs(listFrame:GetChildren()) do
                    if c:IsA("TextButton") then
                        c.BackgroundColor3 = Color3.fromRGB(42, 50, 62)
                    end
                end
                opt.BackgroundColor3 = Color3.fromRGB(70, 120, 190)
                local info = string.format(
                    "Name: %s\nDisplay: %s\nAccount Age: %d days\nTeam: %s",
                    plr.Name, plr.DisplayName, plr.AccountAge,
                    plr.Team and plr.Team.Name or "None"
                )
                infoLabel.Text = info
                print(info)
                notify("Player", "Selected: " .. plr.Name)
            end)
        end
    end
end

