local featContent = tabContents["ФИЧИ"]

-- ESP МОДУЛЬ
local ESP_Settings = {
    Enabled = false,
    ShowNames = true,
    ShowBoxes = true,
    ShowTracers = true,
    MaxDistance = 1000,
    Color = CONFIG.THEME_ACCENT
}
local ESP_Objects = {}
local ESP_Connection = nil

local function UpdateESP()
    if not ESP_Settings.Enabled then
        for _, obj in pairs(ESP_Objects) do
            if obj.Box then obj.Box:Remove() end
            if obj.Name then obj.Name:Remove() end
            if obj.Tracer then obj.Tracer:Remove() end
        end
        ESP_Objects = {}
        return
    end

    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if not hrp or not hum or hum.Health <= 0 then
            if ESP_Objects[plr] then
                if ESP_Objects[plr].Box then ESP_Objects[plr].Box:Remove() end
                if ESP_Objects[plr].Name then ESP_Objects[plr].Name:Remove() end
                if ESP_Objects[plr].Tracer then ESP_Objects[plr].Tracer:Remove() end
                ESP_Objects[plr] = nil
            end
            continue
        end

        local dist = localRoot and (hrp.Position - localRoot.Position).Magnitude or 9999
        if dist > ESP_Settings.MaxDistance then
            if ESP_Objects[plr] then
                if ESP_Objects[plr].Box then ESP_Objects[plr].Box.Visible = false end
                if ESP_Objects[plr].Name then ESP_Objects[plr].Name.Visible = false end
                if ESP_Objects[plr].Tracer then ESP_Objects[plr].Tracer.Visible = false end
            end
            continue
        end

        if not ESP_Objects[plr] then ESP_Objects[plr] = {} end
        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        
        if ESP_Settings.ShowNames then
            if not ESP_Objects[plr].Name then
                ESP_Objects[plr].Name = Drawing.new("Text")
                ESP_Objects[plr].Name.Size = 13
                ESP_Objects[plr].Name.Font = 2
                ESP_Objects[plr].Name.Center = true
                ESP_Objects[plr].Name.Outline = true
                ESP_Objects[plr].Name.Color = ESP_Settings.Color
            end
            ESP_Objects[plr].Name.Text = plr.Name .. " [" .. math.floor(dist) .. "m]"
            ESP_Objects[plr].Name.Position = Vector2.new(screenPos.X, screenPos.Y - 30)
            ESP_Objects[plr].Name.Visible = onScreen
        elseif ESP_Objects[plr].Name then
            ESP_Objects[plr].Name.Visible = false
        end

        if ESP_Settings.ShowBoxes then
            if not ESP_Objects[plr].Box then
                ESP_Objects[plr].Box = Drawing.new("Square")
                ESP_Objects[plr].Box.Thickness = 1
                ESP_Objects[plr].Box.Filled = false
                ESP_Objects[plr].Box.Color = ESP_Settings.Color
            end
            local size = 5000 / dist
            ESP_Objects[plr].Box.Size = Vector2.new(size, size * 1.5)
            ESP_Objects[plr].Box.Position = Vector2.new(screenPos.X - size/2, screenPos.Y - size/2)
            ESP_Objects[plr].Box.Visible = onScreen
        elseif ESP_Objects[plr].Box then
            ESP_Objects[plr].Box.Visible = false
        end

        if ESP_Settings.ShowTracers then
            if not ESP_Objects[plr].Tracer then
                ESP_Objects[plr].Tracer = Drawing.new("Line")
                ESP_Objects[plr].Tracer.Thickness = 1
                ESP_Objects[plr].Tracer.Color = ESP_Settings.Color
            end
            ESP_Objects[plr].Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            ESP_Objects[plr].Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            ESP_Objects[plr].Tracer.Visible = onScreen
        elseif ESP_Objects[plr].Tracer then
            ESP_Objects[plr].Tracer.Visible = false
        end
    end
end

local function ToggleESP(state)
    ESP_Settings.Enabled = state
    if state then
        if not ESP_Connection then
            ESP_Connection = RunService.RenderStepped:Connect(UpdateESP)
            track(ESP_Connection)
        end
    else
        if ESP_Connection then ESP_Connection:Disconnect(); ESP_Connection = nil end
        UpdateESP()
    end
end

