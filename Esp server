local function makeButton(parent, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 40)
    b.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = CONFIG.THEME_TEXT
    b.TextSize = 13
    b.Font = Enum.Font.GothamSemibold
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    b.MouseEnter:Connect(function() TweenService:Create(b, CONFIG.TWEEN_INFO, {BackgroundColor3 = Color3.fromRGB(40, 48, 65)}):Play() end)
    b.MouseLeave:Connect(function() TweenService:Create(b, CONFIG.TWEEN_INFO, {BackgroundColor3 = Color3.fromRGB(30, 35, 45)}):Play() end)
    b.MouseButton1Click:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = CONFIG.THEME_ACCENT}):Play()
        task.delay(0.1, function() TweenService:Create(b, CONFIG.TWEEN_INFO, {BackgroundColor3 = Color3.fromRGB(30, 35, 45)}):Play() end)
        pcall(callback)
    end)
    return b
end

local function makeToggle(parent, text, initial, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 40)
    b.BackgroundColor3 = initial and Color3.fromRGB(30, 80, 60) or Color3.fromRGB(30, 35, 45)
    b.BorderSizePixel = 0
    b.Text = text .. (initial and "  [ВКЛ]" or "  [ВЫКЛ]")
    b.TextColor3 = CONFIG.THEME_TEXT
    b.TextSize = 13
    b.Font = Enum.Font.GothamSemibold
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    local state = initial
    local function update()
        b.Text = text .. (state and "  [ВКЛ]" or "  [ВЫКЛ]")
        TweenService:Create(b, CONFIG.TWEEN_INFO, {BackgroundColor3 = state and Color3.fromRGB(30, 80, 60) or Color3.fromRGB(30, 35, 45)}):Play()
    end
    b.MouseButton1Click:Connect(function() state = not state; update(); pcall(callback, state) end)
    return {set = function(v) state = v; update() end, get = function() return state end}
end

