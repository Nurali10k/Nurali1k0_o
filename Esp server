-- ============ ОБНОВЛЕНИЕ ============
function updateServerInfo()
    pcall(function()
        local jid = game.JobId
        if jid and #jid > 0 then
            jobIdLabel.Text = "  Job ID: " .. jid:sub(1, 22) .. "..."
        else
            jobIdLabel.Text = "  Job ID: Offline/Studio"
        end
        playersLabel.Text = "  Players: " .. #Players:GetPlayers() .. " / " .. Players.MaxPlayers
        pingLabel.Text = "  Ping: " .. getPing() .. " ms"
    end)
end

-- ============ СОБЫТИЯ ============
track(Players.PlayerAdded:Connect(refreshPlayerListUI))
track(Players.PlayerRemoving:Connect(function(plr)
    refreshPlayerListUI()
    if specTarget == plr then stopSpec() end
    if selectedPlayerName == plr.Name then
        selectedPlayerName = nil
        infoLabel.Text = "Выбери игрока из списка"
    end
end))

-- Защита от респавна LocalPlayer (обновляем ссылки)
track(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    -- Проверяем, активен ли fly — если да, выключим (новый персонаж)
    if flyState then stopFly() end
    -- Godmode: если был включён, применим к новому персонажу
    if godToggle and godToggle.get() then
        local hum = getHumanoid(LocalPlayer)
        if hum then
            hum.MaxHealth = math.huge
            hum.Health = math.huge
        end
    end
end))

-- Автообновление сервера
task.spawn(function()
    while _G.NurHubLoaded do
        task.wait(2)
        if mainFrame.Visible or miniIcon.Visible then
            updateServerInfo()
        end
    end
end)

-- Кнопка K
track(UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.K then
        if miniIcon.Visible then
            miniIcon.Visible = false
            mainFrame.Visible = true
        else
            mainFrame.Visible = not mainFrame.Visible
        end
    end
end))

