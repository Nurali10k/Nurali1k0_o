local profContent = tabContents["ПРОФИЛЬ"]
local function makeProfileStat(label, value)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -16, 0, 40)
    f.BackgroundColor3 = Color3.fromRGB(25, 30, 40)
    f.BorderSizePixel = 0
    f.Parent = profContent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0.4, 0, 1, 0)
    l.Position = UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = label
    l.TextColor3 = Color3.fromRGB(150, 150, 160)
    l.TextSize = 13
    l.Font = Enum.Font.Gotham
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f
    
    local v = Instance.new("TextLabel")
    v.Size = UDim2.new(0.6, -10, 1, 0)
    v.Position = UDim2.new(0.4, 10, 0, 0)
    v.BackgroundTransparency = 1
    v.Text = tostring(value)
    v.TextColor3 = CONFIG.THEME_ACCENT
    v.TextSize = 13
    v.Font = Enum.Font.GothamSemibold
    v.TextXAlignment = Enum.TextXAlignment.Right
    v.Parent = f
end

