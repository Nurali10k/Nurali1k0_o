-- Кнопка с hover-эффектом и анимацией
local function makeButton(parent, text, y, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 40)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(45, 55, 70)
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.TextSize = 14
    b.Font = Enum.Font.GothamSemibold
    b.AutoButtonColor = false
    b.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = b

    local baseColor = Color3.fromRGB(45, 55, 70)
    local hoverColor = Color3.fromRGB(65, 80, 105)

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = hoverColor}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = baseColor}):Play()
    end)
    b.MouseButton1Click:Connect(function()
        -- Вспышка
        b.BackgroundColor3 = Color3.fromRGB(90, 140, 200)
        task.delay(0.1, function()
            TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = baseColor}):Play()
        end)
        pcall(callback)
    end)
    return b
end

-- Кнопка-toggle с индикацией
local function makeToggle(parent, text, y, initial, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 40)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = initial and Color3.fromRGB(50, 120, 70) or Color3.fromRGB(45, 55, 70)
    b.BorderSizePixel = 0
    b.Text = text .. (initial and "  [ON]" or "  [OFF]")
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.TextSize = 14
    b.Font = Enum.Font.GothamSemibold
    b.AutoButtonColor = false
    b.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = b

    local state = initial
    local baseText = text

    local function update()
        b.Text = baseText .. (state and "  [ON]" or "  [OFF]")
        TweenService:Create(b, TweenInfo.new(0.2), {
            BackgroundColor3 = state and Color3.fromRGB(50, 120, 70) or Color3.fromRGB(45, 55, 70)
        }):Play()
    end

    b.MouseButton1Click:Connect(function()
        state = not state
        update()
        pcall(callback, state)
    end)

    return {
        btn = b,
        set = function(v)
            state = v
            update()
        end,
        get = function() return state end,
    }
end

